{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@types/*": ["src/types/*"],
      "@lib/*": ["src/lib/*"],
      "@data/*": ["../reports/portal/*"]
    },
    "resolveJsonModule": true
  }
}

