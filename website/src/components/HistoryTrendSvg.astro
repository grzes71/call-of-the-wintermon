---
/**
 * HistoryTrendSvg.astro
 * Native SVG multi-version trend visualization (RAM utilization & binary size).
 * Pure SVG, zero Chart.js, zero client runtime.
 */

import type { ReleaseSnapshot } from '../types/releases';
import { formatBytes } from '../lib/data';

interface Props {
  snapshots: ReleaseSnapshot[];
}

const { snapshots } = Astro.props;

// If insufficient data, handle cleanly
const hasData = snapshots && snapshots.length > 0;

// Coordinate geometry
const width = 640;
const height = 240;
const padLeft = 70;
const padRight = 30;
const padTop = 30;
const padBottom = 40;

const chartWidth = width - padLeft - padRight;
const chartHeight = height - padTop - padBottom;

// Data extraction: Allocated bytes and Free bytes
const dataPoints = snapshots.map((s, index) => {
  const mem = s.memory_report.memory_summary;
  const x = snapshots.length > 1
    ? padLeft + (index / (snapshots.length - 1)) * chartWidth
    : padLeft + chartWidth / 2;
  return {
    version: s.version,
    tag: s.release_tag,
    allocated: mem.total_allocated_bytes,
    free: mem.total_free_bytes,
    binarySize: s.binary_size_bytes,
    x,
  };
});

// Scale Y: bounds around 40,000 to 41,000 (User RAM is 40,960)
const minY = 40000;
const maxY = 41000;

function getY(val: number): number {
  const norm = (val - minY) / (maxY - minY);
  return height - padBottom - norm * chartHeight;
}

// Generate SVG polyline path strings
const allocatedPoints = dataPoints.map((d) => `${d.x},${getY(d.allocated)}`).join(' ');
const userRamLimitY = getY(40960);
---

<div class="border border-atari-border bg-atari-surface/60 rounded-lg p-5 space-y-4 font-mono">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-atari-border pb-3">
    <div>
      <h3 class="text-sm font-bold text-atari-text uppercase tracking-wider flex items-center gap-2">
        <span class="text-atari-amber">&gt;</span>
        <span>HISTORICAL MEMORY CONSUMPTION TREND</span>
      </h3>
      <p class="text-xs text-atari-muted mt-0.5">
        Empirical measurements from release binaries across versions.
      </p>
    </div>
    <div class="flex items-center gap-4 text-xs">
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-atari-green inline-block"></span> Allocated RAM</span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-0.5 bg-red-400 inline-block border-t border-dashed border-red-400"></span> 40 KB Limit</span>
    </div>
  </div>

  {hasData ? (
    <div class="w-full overflow-x-auto">
      <svg class="w-full max-w-2xl mx-auto block text-xs" viewBox={`0 0 ${width} ${height}`}>
        <!-- Grid lines & Labels -->
        <line x1={padLeft} y1={padTop} x2={width - padRight} y2={padTop} stroke="#1b2a47" stroke-width="1" />
        <text x={padLeft - 10} y={padTop + 4} text-anchor="end" fill="#64748b" font-size="10">41,000 B</text>

        <!-- 40,960 B Limit line -->
        <line x1={padLeft} y1={userRamLimitY} x2={width - padRight} y2={userRamLimitY} stroke="#ef4444" stroke-width="1.5" stroke-dasharray="4,4" />
        <text x={width - padRight - 5} y={userRamLimitY - 5} text-anchor="end" fill="#ef4444" font-size="9" font-weight="bold">MAX RAM: 40,960 B</text>

        <line x1={padLeft} y1={getY(40500)} x2={width - padRight} y2={getY(40500)} stroke="#1b2a47" stroke-width="1" />
        <text x={padLeft - 10} y={getY(40500) + 4} text-anchor="end" fill="#64748b" font-size="10">40,500 B</text>

        <line x1={padLeft} y1={height - padBottom} x2={width - padRight} y2={height - padBottom} stroke="#1b2a47" stroke-width="1" />
        <text x={padLeft - 10} y={height - padBottom + 4} text-anchor="end" fill="#64748b" font-size="10">40,000 B</text>

        <!-- Trend Line -->
        <polyline
          fill="none"
          stroke="#00ff66"
          stroke-width="2.5"
          points={allocatedPoints}
        />

        <!-- Data Points & Labels -->
        {dataPoints.map((d) => (
          <g>
            <circle cx={d.x} cy={getY(d.allocated)} r="4.5" fill="#06080e" stroke="#00ff66" stroke-width="2" />
            <!-- Value text -->
            <text x={d.x} y={getY(d.allocated) - 10} text-anchor="middle" fill="#00ff66" font-size="10" font-weight="bold">
              {d.allocated} B
            </text>
            <!-- Version label on X axis -->
            <text x={d.x} y={height - 12} text-anchor="middle" fill="#94a3b8" font-size="11" font-weight="bold">
              {d.tag}
            </text>
          </g>
        ))}
      </svg>
    </div>
  ) : (
    <div class="text-xs text-atari-muted py-6 text-center">
      No historical snapshot data found. Run <code class="text-atari-green">make portal_data</code> to compile snapshots.
    </div>
  )}

  <!-- Evolution Table -->
  <div class="overflow-x-auto border-t border-atari-border/40 pt-3">
    <table class="w-full text-left text-xs">
      <thead>
        <tr class="text-atari-muted border-b border-atari-border/60">
          <th class="py-1.5">RELEASE</th>
          <th class="py-1.5">BINARY SIZE</th>
          <th class="py-1.5">USER RAM USED</th>
          <th class="py-1.5">FREE HEADROOM</th>
          <th class="py-1.5">UTILIZATION</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-atari-border/30">
        {dataPoints.map((dp, i) => {
          const prev = i > 0 ? dataPoints[i - 1] : null;
          const diff = prev ? dp.allocated - prev.allocated : 0;
          return (
            <tr class="hover:bg-atari-surfaceLight/30">
              <td class="py-2 font-bold text-atari-text">{dp.tag}</td>
              <td class="py-2 text-atari-muted font-mono">{formatBytes(dp.binarySize)}</td>
              <td class="py-2 font-mono text-atari-green font-bold">
                {formatBytes(dp.allocated)}
                {diff !== 0 && (
                  <span class={`text-[10px] ml-1.5 ${diff > 0 ? 'text-amber-400' : 'text-emerald-400'}`}>
                    ({diff > 0 ? `+${diff}` : `${diff}`} B)
                  </span>
                )}
              </td>
              <td class="py-2 font-mono text-atari-cyan font-bold">{formatBytes(dp.free)}</td>
              <td class="py-2 text-atari-muted font-mono">{((dp.allocated / 40960) * 100).toFixed(2)}%</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>

